# Google Gemini LLM Configuration
# Set LLM_PROVIDER to 'gemini' for live API calls or 'fake' for offline testing.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Copy this file to .env and insert your real Gemini API key locally.
# DO NOT commit .env to source control (.gitignore protects .env).
LLM_API_KEY=

# Application Limits
MAX_INPUT_LENGTH=2000

# Supabase Database Configuration
# Provide your Supabase project URL and anon/publishable API key.
# DO NOT put service-role or secret keys here.
SUPABASE_URL=
SUPABASE_KEY=

# Supabase JWT Secret for offline token validation (optional, falls back to online validation)
SUPABASE_JWT_SECRET=

# Server Environment and CORS Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api/v1
